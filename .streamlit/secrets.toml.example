# Streamlit Cloud: paste this into the app's Secrets box. Local: copy to secrets.toml (git-ignored) and fill it in.
# Supabase > Connect > Session pooler. Use the READ-ONLY BPP login pulse_reader_bpp (it can only SELECT BPP rows),
# never pulse_reader (PediaWell), never pulse_etl, never the postgres owner.
[supabase]
host = "aws-0-ap-southeast-1.pooler.supabase.com"
port = 5432
dbname = "postgres"
user = "pulse_reader_bpp.<project-ref>"
password = "<the pulse_reader_bpp password>"
